# Service
APP_NAME=policy-rag-llm
APP_ENV=local
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# OpenAI model identifiers and credential
LLM_MODEL=YOUR_LLM_MODEL
EMBEDDING_MODEL=YOUR_EMBEDDING_MODEL
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# RAG indexing and search
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
MIN_RELEVANCE_SCORE=0.2
MAX_QUESTION_LENGTH=1000
VECTOR_INDEX_CACHE_PATH=data/processed/rag_vector_index.json

# LangSmith tracing (disabled until explicitly enabled with a real API key)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=skn34-3rd-project
LANGSMITH_API_KEY=YOUR_LANGSMITH_API_KEY
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true
